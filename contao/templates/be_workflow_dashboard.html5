<?php
/** @var \Contao\BackendTemplate $this */
$esc = static fn ($v): string => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
$l = $this->dash;
?>
<div id="tl_buttons">
  <a href="<?= $esc($this->restoreDemoUrl) ?>" class="tl_submit" style="float:none;display:inline-block;" onclick="return confirm('Demo-Workflow mit synthetischen Daten (neu) anlegen? Ein vorhandener Demo-Workflow gleichen Namens wird dabei ersetzt.');">Demo-Workflow wiederherstellen</a>
</div>

<?= $this->messages ?>

<h2 class="sub_headline"><?= $l['heading'] ?></h2>

<?php if ((int) $this->stuckQueue > 0): ?>
  <p class="tl_error" style="margin-bottom:1.5em;font-weight:bold;"><?= $esc(sprintf($l['stuck_queue'], (int) $this->stuckQueue)) ?></p>
<?php endif; ?>

<?php $cs = $this->cronStatus; ?>
<div class="<?= $cs['cronOk'] ? 'tl_info' : 'tl_error' ?> wf-cron-status" style="margin-bottom:1.5em;">
  <p style="margin:0;<?= $cs['cronOk'] ? '' : 'font-weight:bold;' ?>"><?= $esc($cs['cron']) ?></p>
  <?php if ('' !== $cs['bounce']): ?>
    <p style="margin:.4em 0 0;">
      <?= $esc($cs['bounce']) ?>
      <a href="<?= $esc($this->bounceCheckUrl) ?>" class="tl_submit" style="float:none;display:inline-block;margin-left:.6em;text-decoration:none;" data-turbo="false"><?= $l['bounce_check_now'] ?></a>
    </p>
  <?php endif; ?>
  <?php if ('' !== ($cs['foreign'] ?? '')): ?>
    <p style="margin:.4em 0 0;"><?= $esc($cs['foreign']) ?></p>
  <?php endif; ?>
  <?php $bt = $this->bounceTest; ?>
  <?php if ('' !== ($bt['text'] ?? '')): ?>
    <p style="margin:.4em 0 0;<?= $bt['warn'] ? 'font-weight:bold;' : '' ?>"><?= $esc($bt['text']) ?></p>
  <?php endif; ?>
  <?php if (!empty($this->bounceTestWorkflows)): ?>
    <form method="post" action="<?= $esc($this->bounceTestUrl) ?>" style="margin:.6em 0 0;" data-turbo="false">
      <input type="hidden" name="REQUEST_TOKEN" value="<?= $esc($this->rt) ?>">
      <label><?= $l['bounce_test_label'] ?>
        <select name="workflow" class="tl_select" style="width:auto;max-width:20em;">
          <?php foreach ($this->bounceTestWorkflows as $wfId => $wfTitle): ?>
            <option value="<?= (int) $wfId ?>"><?= $esc($wfTitle) ?></option>
          <?php endforeach; ?>
        </select>
      </label>
      <button type="submit" class="tl_submit" style="float:none;margin-left:.4em;"><?= $l['bounce_test_start'] ?></button>
      <span class="tl_help" style="display:block;margin-top:.3em;"><?= $esc($l['bounce_test_hint']) ?></span>
    </form>
  <?php endif; ?>
</div>

<?php if (!empty($this->bounceBanner)): $b = $this->bounceBanner; ?>
  <?php if ('error' === $b['level']): ?>
    <p class="tl_error" style="margin-bottom:1.5em;font-weight:bold;"><?= $esc($b['message']) ?></p>
  <?php else: ?>
    <p class="tl_info" style="margin-bottom:1.5em;"><?= $esc($b['message']) ?></p>
  <?php endif; ?>
<?php endif; ?>

<?php if (null !== $this->mailboxDialog): $md = $this->mailboxDialog; $f = $md['form']; ?>
<details class="tl_box" style="margin-bottom:1.5em;padding:1em;"<?= (null === $md['source'] || $md['passwordUnreadable']) ? ' open' : '' ?>>
  <summary style="cursor:pointer;font-weight:bold;"><?= $l['mailbox_title'] ?></summary>
  <p class="tl_help" style="margin:.6em 0;"><?= $esc($l['mailbox_intro']) ?></p>
  <?php if ('env' === $md['source']): $e = $md['env']; ?>
    <p class="tl_info" style="margin:.6em 0;"><?= $esc(sprintf($l['mailbox_env'], $e['host'], $e['port'], $e['user'], $md['address'] ?? $l['mailbox_no_address'])) ?></p>
  <?php else: ?>
    <?php if ($md['passwordUnreadable']): ?>
      <p class="tl_error" style="margin:.6em 0;"><?= $esc($l['mailbox_password_reenter']) ?></p>
    <?php endif; ?>
    <?php if (!$md['sodium']): ?>
      <p class="tl_error" style="margin:.6em 0;"><?= $esc($l['mailbox_err_sodium']) ?></p>
    <?php endif; ?>
    <form method="post" action="<?= $esc($this->mailboxUrl) ?>" data-turbo="false" autocomplete="off">
      <input type="hidden" name="REQUEST_TOKEN" value="<?= $esc($this->rt) ?>">
      <table style="border-collapse:collapse;margin:.4em 0;">
        <tr>
          <td style="padding:.25em .8em .25em 0;"><label for="wf-mb-address"><?= $l['mailbox_address'] ?></label></td>
          <td><input id="wf-mb-address" type="email" name="address" class="tl_text" style="width:22em;" required value="<?= $esc($f['address']) ?>"></td>
        </tr>
        <tr>
          <td style="padding:.25em .8em .25em 0;"><label for="wf-mb-host"><?= $l['mailbox_host'] ?></label></td>
          <td><input id="wf-mb-host" type="text" name="host" class="tl_text" style="width:22em;" required placeholder="w0123456.kasserver.com" value="<?= $esc($f['host']) ?>"></td>
        </tr>
        <tr>
          <td style="padding:.25em .8em .25em 0;"><label for="wf-mb-port"><?= $l['mailbox_port'] ?></label></td>
          <td>
            <input id="wf-mb-port" type="text" inputmode="numeric" name="port" class="tl_text" style="width:5em;" required value="<?= (int) $f['port'] ?>">
            <select name="encryption" class="tl_select" style="width:auto;" aria-label="<?= $esc($l['mailbox_encryption']) ?>">
              <?php foreach (['ssl', 'tls', 'none'] as $enc): ?>
                <option value="<?= $enc ?>"<?= $enc === $f['encryption'] ? ' selected' : '' ?>><?= $esc($l['mailbox_enc_'.$enc]) ?></option>
              <?php endforeach; ?>
            </select>
          </td>
        </tr>
        <tr>
          <td style="padding:.25em .8em .25em 0;"><label for="wf-mb-user"><?= $l['mailbox_user'] ?></label></td>
          <td><input id="wf-mb-user" type="text" name="user" class="tl_text" style="width:22em;" placeholder="<?= $esc($l['mailbox_user_placeholder']) ?>" value="<?= $esc($f['user']) ?>"></td>
        </tr>
        <tr>
          <td style="padding:.25em .8em .25em 0;"><label for="wf-mb-password"><?= $l['mailbox_password'] ?></label></td>
          <td><input id="wf-mb-password" type="password" name="password" class="tl_text" style="width:22em;" autocomplete="new-password"<?= $md['passwordSet'] && !$md['passwordUnreadable'] ? ' placeholder="'.$esc($l['mailbox_password_kept']).'"' : ' required' ?>></td>
        </tr>
      </table>
      <p style="margin:.6em 0 0;">
        <button type="submit" name="action" value="check" class="tl_submit" style="float:none;"><?= $l['mailbox_save_check'] ?></button>
        <button type="submit" name="action" value="save" class="tl_submit" style="float:none;"><?= $l['mailbox_save'] ?></button>
        <?php if ($md['stored']): ?>
          <button type="submit" name="action" value="clear" class="tl_submit" style="float:none;" formnovalidate onclick="return confirm('<?= $esc($l['mailbox_clear_confirm']) ?>');"><?= $l['mailbox_clear'] ?></button>
        <?php endif; ?>
      </p>
      <p class="tl_help" style="margin:.6em 0 0;"><?= $esc($l['mailbox_hints']) ?></p>
    </form>
  <?php endif; ?>
</details>
<?php endif; ?>

<details class="tl_box" style="margin-bottom:1.5em;padding:1em;">
  <summary style="cursor:pointer;font-weight:bold;">Workflow-Konfiguration importieren</summary>
  <form method="post" action="<?= $esc($this->importUrl) ?>" enctype="multipart/form-data" style="margin-top:1em;">
    <input type="hidden" name="REQUEST_TOKEN" value="<?= $esc($this->rt) ?>">
    <p style="margin:.3em 0;">Konfigurationsdatei (JSON-Export): <input type="file" name="configFile" accept=".json,application/json" required></p>
    <p style="margin:.3em 0;">
      <label><input type="checkbox" name="createMaster" value="1" checked> Briefpapier-Konfiguration anlegen</label>
      &nbsp;&nbsp;
      <label><input type="checkbox" name="createNotifications" value="1"> E-Mail-Vorlagen anlegen</label>
    </p>
    <p style="margin:.6em 0 0;">
      <button type="submit" class="tl_submit">Konfiguration importieren</button>
      <span class="tl_info" style="margin-left:.6em;">Der importierte Workflow hat keine Quelldatei und ist zunächst „nicht ausführbar" – ordne danach im Workflow eine passende Quelldatei zu.</span>
    </p>
  </form>
</details>

<?php if (!$this->hasWorkflows): ?>
  <p class="tl_info"><?= $l['no_workflows'] ?></p>
<?php else: ?>

  <?php foreach ($this->workflows as $wf): ?>
    <div class="tl_box wf-box" data-wf="<?= (int) $wf['id'] ?>" style="margin-bottom:1.5em;padding:1em;">
      <h3 style="margin-top:0;">
        <?= $esc($wf['title']) ?>
        <?php if (!$wf['published']): ?><span style="color:#b33;font-size:.8em;"><?= $l['unpublished'] ?></span><?php endif; ?>
        <?php if (!$wf['runnable']): ?><span class="wf-badge"><?= $l['not_runnable'] ?></span><?php endif; ?>
      </h3>

      <?php if (!$wf['runnable']): ?>
        <p class="tl_error" style="margin-bottom:1em;">
          <?= $l['not_runnable_msg'] ?> <?= $esc(implode(' ', $wf['problems'])) ?>
        </p>
      <?php else: ?>
        <?php // Die Daten passen nicht (mehr) zur Quelldatei – dieselbe Regel wie in der
              // Bearbeitungsmaske (WorkflowValidator::isSourceDirty), nur zwei Wortlaute. ?>
        <?php if (!empty($wf['sourceDirty'])): ?>
          <p class="tl_error" style="margin-bottom:1em;font-weight:bold;">
            <?= !empty($wf['neverImported']) ? $l['no_import'] : $l['reimport_needed'] ?>
          </p>
        <?php elseif (0 === (int) $wf['total']): ?>
          <?php // Restfall: importiert, danach wurden alle Einträge entfernt. Nur hier, sonst
                // stünden zwei Hinweisboxen mit derselben Aufforderung übereinander. ?>
          <p class="wf-warn"><?= $l['no_import'] ?></p>
        <?php endif; ?>
        <?php if (!$wf['canSend']): ?>
          <p class="wf-warn">Versand nicht möglich: <?= $esc(implode('; ', $wf['sendBlockers'])) ?>. (Formularseite + Benachrichtigung – siehe ANLEITUNG.md, Abschnitt 1–2.)</p>
        <?php endif; ?>
      <?php endif; ?>


      <div style="display:flex;gap:2em;flex-wrap:wrap;margin-bottom:1em;">
        <div><strong style="font-size:1.6em;"><?= (int) $wf['completed'] ?></strong><br><?= $l['completed'] ?></div>
        <div><strong style="font-size:1.6em;"><?= (int) $wf['open'] ?></strong><br><?= $l['open'] ?></div>
        <div><strong style="font-size:1.6em;"><?= (int) $wf['total'] ?></strong><br><?= $l['total'] ?></div>
      </div>

      <table class="tl_listing" style="margin-bottom:1em;">
        <thead><tr><th><?= $l['col_step'] ?></th><th><?= $l['col_status'] ?></th><th><?= $l['col_count'] ?></th></tr></thead>
        <tbody>
        <?php foreach ($wf['breakdown'] as $step): ?>
          <tr>
            <td><?= $esc($step['label']) ?></td>
            <td><?= (int) $step['index'] ?></td>
            <td><?= (int) $step['count'] ?></td>
          </tr>
        <?php endforeach; ?>
        </tbody>
      </table>

      <?php
        // Buttons in the order the work happens: configure, import, look at what the import
        // did, send, take the data out. Import and send need a runnable workflow (and the
        // send its prerequisites); the log and the download are history and therefore always
        // available – there is a log to read precisely when something is off.
      ?>
      <div class="wf-actions">
        <a class="tl_submit" href="<?= $esc($wf['urls']['manage']) ?>"><?= $l['btn_edit'] ?></a>

        <?php // Startet den Import direkt (additiv, es wird nichts gelöscht). Der frühere
              // Dialog mit der Modus-Wahl ist stillgelegt – siehe wf-dialog--import weiter
              // unten. Zum Reaktivieren: hier wieder einen
              // <button type="button" class="tl_submit wf-open-import"> mit demselben Label
              // ausgeben, den Dialogblock unten freischalten (if (false) entfernen) und in
              // workflow-backend.js den wireDialog-Aufruf einkommentieren. ?>
        <?php if ($wf['runnable']): ?>
          <a class="tl_submit" href="<?= $esc($wf['urls']['import']) ?>"><?= $l['btn_import'] ?></a>
        <?php else: ?>
          <span class="tl_submit wf-disabled"><?= $l['btn_import'] ?></span>
        <?php endif; ?>

        <button type="button" class="tl_submit wf-open-log"><?= $l['btn_log'] ?></button>

        <?php if ($wf['runnable'] && $wf['canSend']): ?>
          <button type="button" class="tl_submit wf-open-dialog"><?= $l['btn_send'] ?></button>
        <?php else: ?>
          <span class="tl_submit wf-disabled"<?= [] !== $wf['sendBlockers'] ? ' title="'.$esc(implode('; ', $wf['sendBlockers'])).'"' : '' ?>><?= $l['btn_send'] ?></span>
        <?php endif; ?>

        <button type="button" class="tl_submit wf-open-download"><?= $l['btn_download'] ?></button>
      </div>

      <?php // The import log: what each run did, so a state can be explained afterwards.
            // Same table as in the workflow's edit mask (ImportLogRenderer). ?>
      <div class="wf-dialog wf-dialog--log" hidden>
        <div class="wf-dialog-box wf-dialog-box--wide">
          <button type="button" class="wf-dialog-close" title="<?= $esc($l['close']) ?>">×</button>
          <h3><?= $l['btn_log'] ?> – <?= $esc($wf['title']) ?></h3>
          <p class="wf-choice-lead"><?= $l['log_hint'] ?></p>
          <?php // Safe HTML: built server-side by ImportLogRenderer, every value escaped. ?>
          <?= $wf['importLog'] ?>
        </div>
      </div>

      <?php // STILLGELEGT: der Import-Dialog mit der Wahl zwischen „additiv" und „absolut".
            // „Absolut" löschte mit einem Klick Einträge samt bereits erzeugter PDFs – auch
            // bereits beantwortete –, sobald ihre Zeile in der Quelldatei fehlte oder
            // ausgeblendet war. Ein Fehlgriff im Dialog war damit nicht rückholbar. Der
            // Button oben löst jetzt direkt den additiven Import aus.
            //
            // Der Block bleibt stehen (statt gelöscht zu werden) und ist über `if (false)`
            // abgeschaltet: so bleibt er syntaxgeprüft und mit einer Zeile reaktivierbar.
            // Dazu gehören: der Button oben, `urls.importAbsolute` im DashboardModule, die
            // Auswertung von `?mode` im WorkflowActionController und die Option `--mode` des
            // Konsolenbefehls – alle vier sind an derselben Begründung markiert. ?>
      <?php if (false && $wf['runnable']): ?>
        <div class="wf-dialog wf-dialog--import" hidden>
          <div class="wf-dialog-box">
            <button type="button" class="wf-dialog-close" title="<?= $esc($l['close']) ?>">×</button>
            <h3><?= $l['btn_import'] ?></h3>
            <?php // What the two modes do NOT differ in – said first, because that is where
                  // the question "does 'additiv' import hidden rows?" comes from. ?>
            <p class="wf-choice-lead"><?= $l['import_intro'] ?></p>
            <p class="wf-choice">
              <a class="tl_submit" href="<?= $esc($wf['urls']['import']) ?>"><?= $l['import_add'] ?></a>
              <span class="wf-choice-hint"><?= $l['import_add_hint'] ?></span>
            </p>
            <p class="wf-choice">
              <a class="tl_submit" href="<?= $esc($wf['urls']['importAbsolute']) ?>"
                 onclick="return confirm('<?= $esc($l['import_absolute_confirm']) ?>');"><?= $l['import_absolute'] ?></a>
              <span class="wf-choice-hint"><?= $l['import_absolute_hint'] ?></span>
            </p>
          </div>
        </div>
      <?php endif; ?>

      <?php // Data download: pick what goes in, one button. The container follows the
            // selection (see the hint below the button), so the form only submits the
            // selection itself – a GET form, hence the token as a field. ?>
      <div class="wf-dialog wf-dialog--download" hidden
           data-hint-xlsx="<?= $esc($l['download_result_xlsx']) ?>"
           data-hint-csv="<?= $esc($l['download_result_csv']) ?>"
           data-hint-zip="<?= $esc($l['download_result_zip']) ?>"
           data-hint-none="<?= $esc($l['download_result_none']) ?>">
        <div class="wf-dialog-box">
          <button type="button" class="wf-dialog-close" title="<?= $esc($l['close']) ?>">×</button>
          <h3><?= $l['btn_download'] ?></h3>

          <form method="get" action="<?= $esc($wf['urls']['download']) ?>" class="wf-download">
            <input type="hidden" name="rt" value="<?= $esc($wf['rt']) ?>">

            <p class="wf-choice">
              <label><input type="checkbox" name="parts[]" value="xlsx" checked> <?= $l['btn_export_xlsx'] ?></label>
              <span class="wf-choice-hint"><?= $l['download_data_hint'] ?></span>
            </p>
            <p class="wf-choice">
              <label><input type="checkbox" name="parts[]" value="csv"> <?= $l['btn_export_csv'] ?></label>
              <span class="wf-choice-hint"><?= $l['download_csv_hint'] ?></span>
            </p>
            <p class="wf-choice">
              <?php // Nothing to pack while no document exists – the count says so. ?>
              <label><input type="checkbox" name="parts[]" value="pdfs"<?= 0 === (int) $wf['pdfCount'] ? ' disabled' : '' ?>> <?= $l['btn_pdfs'] ?> (<?= (int) $wf['pdfCount'] ?>)</label>
              <span class="wf-choice-hint"><?= $l['download_pdfs_hint'] ?></span>
            </p>

            <p class="wf-download-run">
              <button type="submit" class="tl_submit"><?= $l['download_run'] ?></button>
              <span class="wf-choice-hint" data-download-result><?= $l['download_result_xlsx'] ?></span>
            </p>
          </form>
        </div>
      </div>

      <?php if (!empty($wf['pending'])): ?>
        <details open class="wf-pending">
          <summary><strong><?= $l['pending'] ?> (<?= \count($wf['pending']) ?>)</strong></summary>

          <div class="wf-bulk" style="margin:.6em 0;display:flex;gap:.4em;flex-wrap:wrap;align-items:center;">
            <span><?= $l['selection'] ?></span>
            <button type="button" class="tl_submit wf-sel-all"><?= $l['sel_all'] ?></button>
            <button type="button" class="tl_submit wf-sel-none"><?= $l['sel_none'] ?></button>
            <?php foreach ($wf['selectSteps'] as $s): ?>
              <button type="button" class="tl_submit wf-sel-status" data-status="<?= (int) $s['index'] ?>"><?= $esc($s['label']) ?> (<?= (int) $s['count'] ?>)</button>
            <?php endforeach; ?>
          </div>

          <table class="tl_listing showColumns wf-table">
            <thead>
              <tr>
                <th class="wf-cb"></th>
                <th class="wf-sortable" data-key="email"><?= $l['col_email'] ?></th>
                <?php if ($wf['hasName']): ?><th class="wf-sortable" data-key="name"><?= $l['col_name'] ?></th><?php endif; ?>
                <?php if ($wf['hasVorname']): ?><th class="wf-sortable" data-key="vorname"><?= $l['col_vorname'] ?></th><?php endif; ?>
                <?php if ($wf['hasAbteilung']): ?><th class="wf-sortable" data-key="abteilung"><?= $l['col_abteilung'] ?></th><?php endif; ?>
                <th class="wf-sortable" data-key="status"><?= $l['col_status'] ?></th>
                <th class="wf-sortable" data-key="delivery"><?= $l['col_delivery'] ?></th>
              </tr>
            </thead>
            <tbody>
            <?php foreach ($wf['pending'] as $p): ?>
              <tr data-status="<?= (int) $p['statusIndex'] ?>">
                <td class="wf-cb"><input type="checkbox" class="wf-row" value="<?= (int) $p['id'] ?>" data-status="<?= (int) $p['statusIndex'] ?>" data-email="<?= $esc($p['email']) ?>" data-name="<?= $esc(trim($p['vorname'].' '.$p['name'])) ?>"></td>
                <td data-k="email"><?= $esc($p['email']) ?></td>
                <?php if ($wf['hasName']): ?><td data-k="name"><?= $esc($p['name']) ?></td><?php endif; ?>
                <?php if ($wf['hasVorname']): ?><td data-k="vorname"><?= $esc($p['vorname']) ?></td><?php endif; ?>
                <?php if ($wf['hasAbteilung']): ?><td data-k="abteilung"><?= $esc($p['abteilung']) ?></td><?php endif; ?>
                <td data-k="status"><?= $esc($p['status']) ?></td>
                <td data-k="delivery"><?php if ('bounce' === $p['delivery']): ?><span class="wf-badge wf-badge--bounce" title="<?= $esc($p['bounceInfo']) ?>"><?= $l['delivery_bounce'] ?></span><?php elseif ('error' === $p['delivery']): ?><span class="wf-badge wf-badge--warn" title="<?= $esc($p['sendError']) ?>"><?= $l['delivery_error'] ?></span><?php elseif ('pending' === $p['delivery']): ?><span class="wf-badge wf-badge--pending" title="<?= $esc($p['resultError'] ?: $l['delivery_pending_hint']) ?>"><?= $l['delivery_pending'] ?></span><?php elseif ('sent' === $p['delivery']): ?><span class="wf-badge wf-badge--sent" title="<?= $esc($l['delivery_sent_hint']) ?>"><?= $l['delivery_sent'] ?></span><?php endif; ?></td>
              </tr>
            <?php endforeach; ?>
            </tbody>
          </table>
        </details>

        <div class="wf-dialog wf-dialog--send" hidden
             data-send-url="<?= $esc($wf['sendUrl']) ?>"
             data-invite="<?= (int) $wf['inviteCount'] ?>"
             data-reminder="<?= (int) $wf['reminderCount'] ?>"
             data-invite-status="0" data-reminder-status="1" data-confirmation-status="<?= (int) $wf['finalStatus'] ?>"
             data-hint-manual="<?= $esc($l['hint_manual']) ?>"
             data-hint-auto="<?= $esc($l['hint_auto']) ?>"
             data-no-recipients="<?= $esc($l['no_recipients']) ?>"
             data-confirm-invite="<?= $esc($l['confirm_invite']) ?>"
             data-confirm-reminder="<?= $esc($l['confirm_reminder']) ?>"
             data-confirm-confirmation="<?= $esc($l['confirm_confirmation']) ?>">
          <div class="wf-dialog-box">
            <button type="button" class="wf-dialog-close" title="<?= $esc($l['close']) ?>">×</button>
            <h3><?= $l['btn_send'] ?></h3>

            <div class="wf-step1">
              <p>
                <label><input type="radio" name="wf-mode-<?= (int) $wf['id'] ?>" class="wf-mode" value="auto" checked> <?= $l['mode_auto'] ?></label><br>
                <label><input type="radio" name="wf-mode-<?= (int) $wf['id'] ?>" class="wf-mode" value="manual"> <?= $l['mode_manual'] ?></label>
              </p>
              <p>
                <button type="button" class="tl_submit wf-send" data-type="invite"><?= $l['send_invites'] ?> (<span class="wf-cnt">0</span>)</button>
                <button type="button" class="tl_submit wf-send" data-type="reminder"><?= $l['send_reminders'] ?> (<span class="wf-cnt">0</span>)</button>
                <button type="button" class="tl_submit wf-send" data-type="confirmation"><?= $l['send_confirmations'] ?> (<span class="wf-cnt">0</span>)</button>
              </p>
              <p class="tl_info wf-hint" style="margin:0;"></p>
            </div>

            <form class="wf-step2" method="post" hidden>
              <input type="hidden" name="REQUEST_TOKEN" value="<?= $esc($wf['rt']) ?>">
              <input type="hidden" name="type" class="wf-send-type" value="">
              <p class="wf-confirm-head"></p>
              <ul class="wf-confirm-list" style="max-height:240px;overflow:auto;margin:.4em 0;padding-left:1.2em;"></ul>
              <div class="wf-send-ids"></div>
              <p>
                <button type="submit" class="tl_submit"><?= $l['send_now'] ?></button>
                <button type="button" class="tl_submit wf-back"><?= $l['back'] ?></button>
              </p>
            </form>
          </div>
        </div>
      <?php else: ?>
        <p class="tl_info"><?= $l['no_pending'] ?></p>
      <?php endif; ?>
    </div>
  <?php endforeach; ?>

<?php endif; ?>
